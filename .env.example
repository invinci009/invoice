# Copy to .env and fill in. Never commit .env.
# Port the app listens on
PORT=3000

# REQUIRED in production (NODE_ENV=production refuses to boot without it).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where SQLite db + uploads + generated PDFs live.
# Local dev: leave unset (project folder). Docker: /data (mounted volume).
# DATA_DIR=/data

# Storage backend: sqlite (default, local file) or firestore (Firebase).
# DATA_BACKEND=sqlite

# Firebase (only when DATA_BACKEND=firestore). Spark free plan needs NO card.
# FIREBASE_PROJECT_ID=your-project-id
# STORAGE_BUCKET=your-project-id.appspot.com  (defaults to this)

# NODE_ENV=production
